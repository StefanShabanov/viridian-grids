---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { copy, href, LANGS, site, type Lang, type PageId } from '../content';

interface Props {
  lang: Lang;
  page: PageId;
}

const { lang, page } = Astro.props;
const t = copy[lang];
const meta = t.meta[page];
const title = page === 'home' ? `${site.name} — ${meta.title}` : `${meta.title} — ${site.name}`;
const canonical = new URL(href(lang, page), Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={canonical.href} />
    {
      LANGS.map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(href(l, page), Astro.site ?? Astro.url.origin).href} />
      ))
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={lang === 'bg' ? 'bg_BG' : 'en_GB'} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#1B5E4B" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">{t.a11y.skip}</a>
    <Header lang={lang} page={page} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
