---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { copy, href, LANGS, site, type Lang, type PageId } from '../content';

/** Per-client pages are not part of the public site map. */
type ClientPage = 'clientReport' | 'clientDemo';

interface Props {
  lang: Lang;
  page: PageId | ClientPage;
  /** Keep the page out of search results and out of the sitemap. */
  noindex?: boolean;
}

const { lang, page, noindex = false } = Astro.props;
const t = copy[lang];
const isPublic = !noindex && page in t.meta;
const meta = isPublic ? t.meta[page as PageId] : { title: site.name, description: '' };
const title = page === 'home' ? `${site.name} - ${meta.title}` : `${meta.title} - ${site.name}`;
const canonical = isPublic ? new URL(href(lang, page as PageId), Astro.site ?? Astro.url.origin) : null;
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={meta.description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical.href} />}
    {
      isPublic &&
        LANGS.map((l) => (
          <link rel="alternate" hreflang={l} href={new URL(href(l, page as PageId), Astro.site ?? Astro.url.origin).href} />
        ))
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={meta.description} />
    {canonical && <meta property="og:url" content={canonical.href} />}
    <meta property="og:locale" content={lang === 'bg' ? 'bg_BG' : 'en_GB'} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#1B5E4B" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body id="top">
    <a class="skip" href="#main">{t.a11y.skip}</a>
    <Header lang={lang} page={page} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <a class="totop" href="#top" aria-label={t.a11y.toTop} title={t.a11y.toTop}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
        <path d="M12 19V5M5 12l7-7 7 7" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>

    <script>
      import '../scripts/ui';
    </script>
  </body>
</html>
