---
import { copy, href, type Lang } from '../content';

interface Props {
  lang: Lang;
  heading?: 'h1' | 'h2';
  /** The homepage shows four points and links to the full security page. */
  compact?: boolean;
}
const { lang, heading = 'h2', compact = false } = Astro.props;
const t = copy[lang];
const Heading = heading;
const items = compact ? t.trust.items.slice(0, 4) : t.trust.items;
---

<section class="section section--white">
  <div class="wrap">
    <div class="eyebrow">{t.trust.label}</div>
    <Heading class={heading === 'h1' ? 'h1' : 'h2'} style="max-width: 24ch;">{t.trust.title}</Heading>
    <p class="lede">{t.trust.sub}</p>
    <div class="trust grid-lines">
      {items.map((i) => (
        <div class="trust__item">
          <span class="trust__mark" aria-hidden="true"></span>
          <div>
            <div class="trust__t">{i.t}</div>
            <p class="trust__d">{i.d}</p>
          </div>
        </div>
      ))}
    </div>
    {compact ? (
      <p class="trust__more"><a href={href(lang, 'security')}>{t.trust.more} &rarr;</a></p>
    ) : (
      <p style="margin-top: 20px; font-size: 14px; color: var(--muted-3); max-width: 74ch; line-height: 1.6;">{t.trust.foot}</p>
    )}
  </div>
</section>
