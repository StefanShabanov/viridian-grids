---
import { copy, type Lang } from '../content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy[lang];
---

<section class="section section--white">
  <div class="wrap">
    <div class="eyebrow">{t.services.label}</div>
    <h1 class="h1">{t.services.title}</h1>
    <p class="lede">{t.services.sub}</p>
    <div class="grid-lines" style="margin-top: 44px;">
      {t.services.items.map((s) => (
        <div class="svc">
          <div class="svc__n">{s.n}</div>
          <div>
            <div class="svc__name">{s.name}</div>
            <div class="svc__plans">{s.plans}</div>
          </div>
          <p class="svc__desc">{s.desc}</p>
        </div>
      ))}
    </div>
    <div class="soon">
      <div class="soon__title">{t.services.soonTitle}</div>
      <p class="soon__note">{t.services.soonNote}</p>
      <ol class="soon__list">
        {t.services.soon.map((item) => <li>{item}</li>)}
      </ol>
    </div>
  </div>
</section>
