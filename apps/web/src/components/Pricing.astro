---
import { copy, href, plans, rates, type Lang } from '../content';

interface Props {
  lang: Lang;
  heading?: 'h1' | 'h2';
}

const { lang, heading = 'h2' } = Astro.props;
const t = copy[lang];
const Heading = heading;

// Derived, never typed in twice: an annual plan is `annualMonths` months of the
// monthly price, and the saving is the two months you do not pay for.
const annual = (monthly: number) => monthly * rates.annualMonths;
const fullYear = (monthly: number) => monthly * 12;
const saving = (monthly: number) => fullYear(monthly) - annual(monthly);
---

{/*
  The monthly/annual switch is two radio inputs and sibling selectors - no
  JavaScript, so it works before hydration, with scripting disabled, and without
  loosening the CSP. The radios sit before the cards because `:checked ~` can
  only look forwards.
*/}

<section class="section">
  <div class="wrap">
    <div class="eyebrow">{t.pricing.label}</div>
    <Heading class={heading === 'h1' ? 'h1' : 'h2'}>{t.pricing.title}</Heading>
    <p class="lede" style="max-width: 58ch;">{t.pricing.sub}</p>

    <div class="billing">
      <input class="visually-hidden" type="radio" name="billing" id="bill-monthly" checked />
      <input class="visually-hidden" type="radio" name="billing" id="bill-annual" />

      <div class="billing__switch">
        <label for="bill-monthly">{t.pricing.billing.monthly}</label>
        <label for="bill-annual">
          {t.pricing.billing.annual}
          <span class="billing__save">{t.pricing.billing.save}</span>
        </label>
      </div>

      {/*
        On a phone .plans becomes a scroll-snap carousel (see global.css). The
        featured card is centred on load by a tiny bundled script; the neighbours
        peek at the edges to signal there is more to swipe. On desktop it is the
        grid, untouched.
      */}
      <div class="plans" data-carousel>
        {
          plans.map((plan) => {
            const c = t.pricing.plans[plan.id];
            return (
              <div class={plan.featured ? 'plan plan--featured' : 'plan'}>
                {plan.featured && <div class="plan__badge">{t.pricing.badge}</div>}
                <div class="plan__name">{c.name}</div>

                <div class="plan__price price--monthly">
                  {plan.from && <span class="plan__from">{t.pricing.from}</span>}
                  <b>&euro;{plan.price}</b>
                  <span>{t.pricing.per}</span>
                </div>
                <div class="plan__price price--annual">
                  {plan.from && <span class="plan__from">{t.pricing.from}</span>}
                  <b>&euro;{annual(plan.price)}</b>
                  <span>{t.pricing.perYear}</span>
                </div>
                <div class="plan__saving price--annual">
                  {t.pricing.instead} &euro;{fullYear(plan.price)} · {t.pricing.saveWord} &euro;{saving(plan.price)}
                </div>

                <p class="plan__promise">{c.promise}</p>
                <p class="plan__blurb">{c.blurb}</p>
                <div class="plan__rule" />
                <ul class="plan__features">
                  {c.f.map((f) => (
                    <li>
                      <i aria-hidden="true">&#10003;</i>
                      <span>{f}</span>
                    </li>
                  ))}
                  <li class="price--annual plan__perk">
                    <i aria-hidden="true">&#10003;</i>
                    <span>{t.pricing.annualPerk}</span>
                  </li>
                </ul>

                <a
                  class={plan.featured ? 'btn btn--primary plan__cta' : 'btn btn--ghost plan__cta'}
                  href={href(lang, 'contact')}
                >
                  {t.pricing.cta}
                </a>
              </div>
            );
          })
        }
      </div>

      <div class="carousel-dots" aria-hidden="true">
        {plans.map((plan) => <span class={plan.featured ? 'is-active' : undefined} />)}
      </div>
      <p class="carousel-hint">{t.pricing.swipe}</p>
    </div>

    {/* The rebuild offer, given the prominence it never had as a footnote. */}
    <aside class="rebuild">
      <div class="rebuild__body">
        <div class="rebuild__label">{t.pricing.rebuild.label}</div>
        <h3 class="rebuild__title">{t.pricing.rebuild.title}</h3>
        <p class="rebuild__text">{t.pricing.rebuild.text}</p>
      </div>
      <div class="rebuild__aside">
        <div class="rebuild__price">{t.pricing.rebuild.price}</div>
        <div class="rebuild__priceNote">{t.pricing.rebuild.priceNote}</div>
        <a class="btn btn--onGreen rebuild__cta" href={href(lang, 'services')}>{t.pricing.rebuild.cta}</a>
      </div>
    </aside>

    <p class="pricing__anchor">{t.pricing.anchor}</p>
    <p class="pricing__qualify">{t.pricing.qualify}</p>

    <div class="notes">
      {
        t.pricing.notes.map((n) => (
          <div>
            <span class="notes__k">{n.k}</span>
            <p class="notes__v">{n.v}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import '../scripts/carousel';
</script>
