---
import { copy, href, LANGS, site, type Lang, type PageId } from '../content';

interface Props {
  lang: Lang;
  page: PageId | 'clientReport' | 'clientDemo';
}

const { lang, page } = Astro.props;
const t = copy[lang];

// Client pages are outside the public site, so the language switch falls back
// to the homepage and no nav item is marked current.
const langTarget: PageId = page === 'clientReport' || page === 'clientDemo' ? 'home' : page;

const links: { page: PageId; label: string }[] = [
  { page: 'services', label: t.nav.services },
  { page: 'pricing', label: t.nav.pricing },
  { page: 'how', label: t.nav.how },
  { page: 'report', label: t.nav.report },
  { page: 'faq', label: t.nav.faq },
];
---

{/*
  Narrow screens: brand left, BG/EN and the burger right, the five nav links and
  the call to action inside the panel.

  Built on <details> rather than a script, so it opens with JavaScript disabled,
  is keyboard-operable for free, and needs no 'unsafe-inline' in the CSP.
*/}

<header class="header">
  <div class="wrap header__bar">
    <a class="brand" href={href(lang, 'home')}>
      <span class="brand__mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <span class="brand__name">{site.name}</span>
    </a>

    <nav class="header__nav" aria-label={t.a11y.menu}>
      {
        links.map((l) => (
          <a href={href(lang, l.page)} aria-current={page === l.page ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="header__spacer"></div>

    <div class="lang" role="group" aria-label={t.a11y.language}>
      {
        LANGS.map((l) => (
          <a href={href(l, langTarget)} hreflang={l} aria-current={l === lang ? 'true' : undefined}>
            {l.toUpperCase()}
          </a>
        ))
      }
    </div>

    <a class="btn btn--primary btn--sm header__cta" href={href(lang, 'check')}>{t.nav.cta}</a>

    <details class="menu">
      <summary class="menu__btn" aria-label={t.a11y.menu} title={t.a11y.menu}>
        <span class="burger" aria-hidden="true"></span>
      </summary>
      <nav class="menu__panel" aria-label={t.a11y.menu}>
        {
          links.map((l) => (
            <a href={href(lang, l.page)} aria-current={page === l.page ? 'page' : undefined}>
              {l.label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>
