# Where form submissions are delivered. Both forms go to the same inbox.
LEAD_TO_EMAIL=hello@viridiangrids.com

# Resend (https://resend.com) - free tier is enough at this volume.
# The sending domain must be verified in Resend before this works.
RESEND_API_KEY=
LEAD_FROM_EMAIL=site@viridiangrids.com

# --- Abuse protection (both optional; each activates when its keys are set) ---

# Cloudflare Turnstile - free, privacy-preserving CAPTCHA.
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# The site key is public (ships to the browser); the secret key stays server-side.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis - free tier, for the per-IP form rate limit.
# Create a database at https://console.upstash.com and copy the REST creds.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
